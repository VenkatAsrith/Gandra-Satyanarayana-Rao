# ==============================================================================
# GANDRA SATYANARAYANA RAO (SATHENNA) — MERN APPLICATION ENVIRONMENT CONFIG
# Copy this file to server/.env and fill in the values for your deployment.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/sathenna_profile

# Authentication & Session Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_signing_key_for_session_management

# Initial Admin Bootstrap Secret (Used with setup script or setup endpoint)
ADMIN_SETUP_SECRET=bootstrap_admin_secret_key_change_in_production

# Cloudinary Media Management (Optional: Mock/Local fallback active if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
